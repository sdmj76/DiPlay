<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- BYD vendor read permissions for the HUD test build. All of them are protectionLevel
         dangerous, so none needs the platform signature; see docs/BYD_VENDOR_PERMISSIONS.md.
         The first six are the ones BYD's modified PackageInstaller whitelists and the driver has
         confirmed togglable in BYD Settings -> App -> DiPlay HUD Test -> Permissions. The last
         three are the 2026-10-13 additions: same protection level, but they test whether BYD's
         Settings app (com.byd.vehiclesettings, a separate implementation) also lists them. -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_DOOR_LOCK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_PANORAMA_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_AUDIO_COMMON" />
    <!-- Control only: a stock dangerous permission that belongs to a permission group. It backs no
         BYD device and is of no use in a car; it is here so the probe report shows the one entry
         BYD Settings should list by stock Android behaviour. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
<queries><package android:name="com.byd.clusterdebug" /></queries>
    <application android:label="DiPlay HUD Test" tools:replace="android:label">
    <receiver android:name="com.shilapi.xcertplay.hud.StarterBridgeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    <activity android:name="com.shilapi.xcertplay.hud.StandaloneHudDemoActivity" android:exported="true" android:permission="android.permission.DUMP" />
    <activity android:name="com.shilapi.xcertplay.hud.BydVehiclePermissionsProbeActivity"
        android:exported="true"
        android:label="BYD Permissions Probe"
        android:taskAffinity="com.shihab.diplay.hudtest.probe">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>
    </application></manifest>
